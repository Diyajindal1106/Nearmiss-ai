# Optional: Set your Gemini API key to enable live AI chatbot assistance
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: Allowed CORS origins (comma-separated)
NEARMISS_CORS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Set to 1 to warm up CLIP model in background on server startup
NEARMISS_PRELOAD=0
